  "groups": {
    "iliotibial": {
      "reason": "The iliotibial tracts are thickened fascia lata; this viewer places standalone fascia in Connective tissue.",
      "sources": [
        "bp3d",
        "iliotibial"
      ]
    },
    "skeletal-muscles": {
      "reason": "These are skeletal muscle organs, including pharyngeal muscles, rather than bones, fascia, or airways.",
      "sources": [
        "bp3d",
        "lowerMuscles",
        "shoulderMuscles",
        "pharynx"
      ]
    },
    "skull-bones": {
      "reason": "The inferior nasal conchae and lacrimal bones are bone organs; this viewer places individual bones in Skeleton.",
      "sources": [
        "bp3d",
        "skull"
      ]
    },
    "cartilage": {
      "reason": "The meshes represent cartilage or intervertebral discs; this viewer places separately selectable cartilage and discs in Connective tissue.",
      "sources": [
        "bp3d",
        "cartilage",
        "discs",
        "costal",
        "larynx"
      ]
    },
    "teeth": {
      "reason": "Teeth are accessory digestive organs used for mechanical digestion; the Skeleton layer describes bones.",
      "sources": [
        "bp3d",
        "oral"
      ]
    },
    "gingiva": {
      "reason": "Gingiva is oral mucosa surrounding the teeth, grouped with the mouth in Digestive.",
      "sources": [
        "bp3d",
        "oral",
        "gingiva"
      ]
    },
    "retinacula": {
      "reason": "The wrist flexor retinacula are fibrous bands forming the roof of the carpal tunnel.",
      "sources": [
        "bp3d",
        "retinaculum"
      ]
    },
    "orbital-tendon": {
      "reason": "The common tendinous rings are fibrous origins of extraocular muscles, grouped with standalone tendons and orbital check ligaments.",
      "sources": [
        "bp3d",
        "annulus"
      ]
    },
    "ventricular-system": {
      "reason": "These are cerebral ventricles and the interventricular foramen of the brain, grouped in Nervous system.",
      "sources": [
        "bp3d",
        "ventricles",
        "ventricularAnatomy"
      ]
    },
    "choroid-plexus": {
      "reason": "The cerebral choroid plexuses produce cerebrospinal fluid within the brain ventricular system.",
      "sources": [
        "bp3d",
        "ventricles",
        "ventricularAnatomy"
      ]
    },
    "liver-segments": {
      "reason": "Hepatovenous segments are liver regions defined by drainage territories, grouped in Digestive.",
      "sources": [
        "bp3d",
        "liver"
      ]
    },
    "papillary-muscles": {
      "reason": "Papillary muscles are ventricular myocardium, grouped in Heart rather than the skeletal Muscles layer.",
      "sources": [
        "bp3d",
        "papillary"
      ]
    }
  },
